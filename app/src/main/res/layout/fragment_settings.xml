<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_1" android:textSize="26sp" android:textStyle="bold" android:accessibilityHeading="true" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sound" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/fragment_settings_text_2" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/vibration" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/fragment_settings_text_3" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_4" android:labelFor="@id/default_mode" />
    <Spinner android:id="@+id/default_mode" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/fragment_settings_contentdescription_5" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_6" android:labelFor="@id/cooldown" />
    <Spinner android:id="@+id/cooldown" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/fragment_settings_contentdescription_7" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_8" android:labelFor="@id/default_camera" />
    <Spinner android:id="@+id/default_camera" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/fragment_settings_contentdescription_9" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_10" android:labelFor="@id/theme" />
    <Spinner android:id="@+id/theme" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/fragment_settings_contentdescription_11" />
    <com.google.android.material.button.MaterialButton style="@style/JengaButton" android:id="@+id/settings_clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_12" />
    <com.google.android.material.button.MaterialButton style="@style/JengaButton" android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_13" />
    <com.google.android.material.button.MaterialButton style="@style/JengaButton" android:id="@+id/about" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fragment_settings_text_14" />
</LinearLayout></ScrollView>
