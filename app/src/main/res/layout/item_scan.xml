<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="5dp" app:cardCornerRadius="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:minHeight="80dp">
        <TextView android:id="@+id/row_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/row_details" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/row_note" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton style="@style/JengaButton" android:id="@+id/row_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/item_scan_text_1" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
